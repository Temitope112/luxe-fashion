generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* =========================================================
   PRODUCT
========================================================= */

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  description String?

  price       Decimal  @db.Decimal(10, 2)
  oldPrice    Decimal? @db.Decimal(10, 2)

  rating      Float    @default(0)
  reviews     Int      @default(0)

  badge       String?
  inStock     Boolean  @default(true)

  images      String[]
  colors      String[]
  sizes       String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@index([category])
  @@index([createdAt])
}

/* =========================================================
   USER
========================================================= */

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(USER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]

  @@index([role])
}

/* =========================================================
   ORDER
========================================================= */

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

model Order {
  id               String        @id @default(cuid())

  userId           String

  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)

  firstName        String
  lastName         String
  email            String
  phone            String

  address          String
  city             String
  state            String

  subtotal         Decimal       @db.Decimal(10, 2)
  shipping         Decimal       @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)

  paymentReference String?       @unique

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id])
  items            OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

/* =========================================================
   ORDER ITEM
========================================================= */

model OrderItem {
  id            String   @id @default(cuid())

  orderId       String
  productId     String

  productName   String
  price         Decimal  @db.Decimal(10, 2)
  quantity      Int

  selectedColor String?
  selectedSize  String?

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}